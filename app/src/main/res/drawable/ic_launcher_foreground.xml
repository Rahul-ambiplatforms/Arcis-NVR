<?xml version="1.0" encoding="utf-8"?>
<!--
  App icon foreground — triangular NVR badge with camera-lens symbol.
  Background color #1A1030 is defined in colors.xml and applied by the
  adaptive-icon XML in mipmap-anydpi-v26/.
  User should replace ic_launcher.png / ic_launcher_round.png in each
  mipmap density folder with their own artwork if they want the legacy
  (pre-API-26) icon to exactly match.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer triangle — subtle purple tint -->
    <path
        android:pathData="M54,15 L97,84 L11,84 Z"
        android:strokeColor="#7070CC"
        android:strokeWidth="2.5"
        android:fillColor="#1A1040" />

    <!-- Inner triangle — white outline for depth -->
    <path
        android:pathData="M54,28 L85,76 L23,76 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000" />

    <!-- Camera body -->
    <path
        android:pathData="M38,48 L70,48 L70,66 L38,66 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- Camera viewfinder notch (top-right) -->
    <path
        android:pathData="M64,44 L70,44 L70,48"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- Lens outer ring -->
    <path
        android:pathData="M54,57m-8,0a8,8 0,1,0 16,0a8,8 0,1,0 -16,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#30FFFFFF" />

    <!-- Lens inner dot -->
    <path
        android:pathData="M54,57m-3.5,0a3.5,3.5 0,1,0 7,0a3.5,3.5 0,1,0 -7,0"
        android:fillColor="#FFFFFF" />

    <!-- Apex dot above triangle tip -->
    <path
        android:pathData="M54,22m-2.5,0a2.5,2.5 0,1,0 5,0a2.5,2.5 0,1,0 -5,0"
        android:fillColor="#9090EE" />

</vector>
